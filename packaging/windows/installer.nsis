!include "MUI2.nsh"

; NOTE: This installs the command-line / terminal-UI (miri-cli) build only.
; The desktop GUI (Tauri + React) is built and packaged separately by
; `npm run tauri build` in packages\miri-gui, which produces its own
; NSIS/MSI installer under packages\miri-gui\src-tauri\target\release\bundle.
Name "Miri Cleaner CLI"
OutFile "MiriCleaner-CLI-Setup-0.2.2.exe"
InstallDir "$LOCALAPPDATA\Programs\MiriCleanerCLI"
RequestExecutionLevel user

!define MUI_ABORTWARNING
!define MUI_ICON "..\..\packages\miri-gui\src-tauri\icons\icon.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_LANGUAGE "English"

Section "Miri Cleaner CLI Core" SecCore
    SetOutPath "$INSTDIR"
    File /r "..\..\target\release\miri-cleaner.exe"

    CreateDirectory "$SMPROGRAMS\Miri Cleaner"
    CreateShortCut "$SMPROGRAMS\Miri Cleaner\Miri Cleaner CLI.lnk" "$INSTDIR\miri-cleaner.exe"
    WriteUninstaller "$INSTDIR\uninstall.exe"
SectionEnd

Section "Uninstall"
    Delete "$INSTDIR\miri-cleaner.exe"
    Delete "$INSTDIR\uninstall.exe"
    RMDir /r "$INSTDIR"
    Delete "$SMPROGRAMS\Miri Cleaner\Miri Cleaner CLI.lnk"
    RMDir "$SMPROGRAMS\Miri Cleaner"
SectionEnd
